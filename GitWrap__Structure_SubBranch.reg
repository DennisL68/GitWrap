Windows Registry Editor Version 5.00

; Windows only support 16 static context menus...

[HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\GitWrapSub_Branch\shell\10_New]
"Icon"="C:\\Program Files\\Git\\git-bash.exe"
"MUIVerb"="New Local Area [Checkout -b]"

[HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\GitWrapSub_Branch\shell\11_Switch]
"Icon"="C:\\Program Files\\Git\\git-bash.exe"
"MUIVerb"="Switch Local Area [Branch switch]"

[HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\GitWrapSub_Branch\shell\12_LocalDel]
"Icon"="C:\\Program Files\\Git\\git-bash.exe"
"MUIVerb"="Delete Local Area [Branch -d]"

; [HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\GitWrapSub_Branch\shell\13_RemoteDel]
; "Icon"="C:\\Program Files\\Git\\git-bash.exe"
; "MUIVerb"="Delete Remote Area [Push ]"

[HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\GitWrapSub_Branch\shell\14_RefreshRemote]
"Icon"="C:\\Program Files\\Git\\git-bash.exe"
"MUIVerb"="Purge Remote Area Info [Update --prune]"