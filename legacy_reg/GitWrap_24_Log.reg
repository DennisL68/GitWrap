Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\SOFTWARE\Classes\Directory\ContextMenus\GitWrap\shell\24_Log\command]
; $cmd = @'
; git log --pretty=format:"%C(yellow)%h %Cgreen%ad %Cblue| %Creset%s%C(red)%d %Creset[%C(magenta)%an%Creset]" --date=iso
; '@
; [System.Convert]::ToBase64String([System.Text.Encoding]::Unicode.GetBytes($cmd))
@="pwsh.exe -WindowStyle normal -NoExit -EncodedCommand "
